{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon.ico", "/index.csr.html", "/index.html", "/manifest.webmanifest", "/*.css", "/*.js"]
      }
    },
    {
      "name": "contenu",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/assets/data/**"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)", "/assets/**"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "tuiles-osm",
      "urls": ["https://tile.openstreetmap.org/**"],
      "cacheConfig": { "strategy": "performance", "cacheOpaqueResponses": false, "maxSize": 500, "maxAge": "30d" }
    }
  ]
}
