{
  "name": "leurio",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "node scripts/build-reel.mjs",
    "build:emulateurs": "ng build --configuration emulateurs",
    "watch": "ng build --watch --configuration development",
    "lint": "ng lint && stylelint \"src/**/*.{css,scss}\"",
    "typecheck": "ngc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "test": "ng test --watch=false",
    "validate-data": "node scripts/validate-data.ts",
    "test:acceptance": "node --test --test-concurrency=1 \"tests/acceptance/*.test.mjs\"",
    "test:e2e": "playwright test",
    "icons": "node scripts/generate-icons.mjs",
    "cap:sync": "cap sync",
    "test:android": "node --test tests/android/*.test.mjs",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-leurio \"node scripts/run-rules-tests.mjs\""
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/service-worker": "^22.2.4",
    "@capacitor/android": "^8.6.0",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/core": "^8.6.0",
    "@capacitor/geolocation": "^8.2.4",
    "@capacitor/ios": "^8.6.0",
    "@ionic/angular": "^9.0.10",
    "firebase": "^13.1.0",
    "ionicons": "^8.1.0",
    "rxjs": "~7.8.0",
    "suncalc": "2.1.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.0",
    "@capacitor/cli": "^8.6.0",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "1.63.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "angular-eslint": "22.6.0",
    "eslint": "^10.12.0",
    "fake-indexeddb": "^6.2.7",
    "firebase-tools": "^15.34.2",
    "jsdom": "^30.0.0",
    "postcss-scss": "4.0.9",
    "prettier": "^3.8.1",
    "stylelint": "17.16.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
