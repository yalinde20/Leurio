rules_version = '2';

// Règles d'accès Firestore (PLAN §7), testées sur l'émulateur : npm run test:rules.
service cloud.firestore {
  match /databases/{database}/documents {

    // PLAN §7 : users/** lisible et modifiable seulement par son propriétaire
    // (profil, tackleBox, spots).
    // À verrouiller avant la monétisation : l'utilisateur peut écrire son propre
    // champ `plan` (accepté tel quel pour l'instant, selon le plan).
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // PLAN §7 : feedback en création seule, sans uid ni coordonnées exactes.
    // Un compte anonyme suffit ; lecture, modification et suppression sont refusées.
    match /feedback/{id} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['conseilId', 'typeId', 'techniqueId', 'utile', 'conditions', 'date'])
        && !request.resource.data.keys().hasAny(['uid', 'lat', 'lng', 'latitude', 'longitude'])
        && (!('conditions' in request.resource.data)
          || (request.resource.data.conditions is map
            && request.resource.data.conditions.keys().hasOnly(['tempEau', 'vent', 'debitTendance', 'pressionTendance48h', 'pression', 'departement'])));
    }

    // Tout le reste est refusé (refus par défaut).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
