{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Types de leurres (lure-types.json)",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "nom",
      "famille",
      "especes",
      "zoneNage",
      "interditFermetureBrochet",
      "sources",
      "dateVerif"
    ],
    "additionalProperties": true,
    "not": {
      "required": [
        "tailleCm",
        "poidsG"
      ]
    },
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "nom": {
        "type": "string",
        "minLength": 1
      },
      "famille": {
        "type": "string",
        "minLength": 1,
        "description": "Famille de leurres (Souples, Durs…), utilisée pour filtrer la boîte."
      },
      "especes": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "techniques": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "zoneNage": {
        "enum": [
          "surface",
          "mi-eau",
          "fond"
        ]
      },
      "interditFermetureBrochet": {
        "type": "boolean"
      },
      "faibleLumiere": {
        "type": "boolean",
        "description": "Vrai si ce type de leurre est adapté à la faible lumière (aube, crépuscule, ciel couvert)."
      },
      "saisons": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "enum": [
            "hiver",
            "printemps",
            "été",
            "automne"
          ]
        }
      },
      "tailleCm": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "description": "Gamme de taille du leurre, en cm : [min, max], 0 < min < max. Un type porte tailleCm ou poidsG, jamais les deux.",
        "items": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "poidsG": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "description": "Gamme de poids du leurre, en g : [min, max], 0 < min < max. Un type porte poidsG ou tailleCm, jamais les deux.",
        "items": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "poidsTeteG": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "description": "Gamme de poids de la tête plombée, en g : [min, max], 0 < min < max. Optionnel : seulement pour les leurres souples montés sur tête.",
        "items": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "sources": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "dateVerif": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "format": "date"
      }
    }
  }
}
