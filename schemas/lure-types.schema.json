{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Types de leurres (lure-types.json)",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "nom",
      "especes",
      "zoneNage",
      "interditFermetureBrochet",
      "sources",
      "dateVerif"
    ],
    "additionalProperties": true,
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "nom": {
        "type": "string",
        "minLength": 1
      },
      "especes": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "techniques": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "zoneNage": {
        "enum": [
          "surface",
          "mi-eau",
          "fond"
        ]
      },
      "interditFermetureBrochet": {
        "type": "boolean"
      },
      "sources": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "dateVerif": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "format": "date"
      }
    }
  }
}
