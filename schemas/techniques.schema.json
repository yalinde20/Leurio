{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Animations (techniques.json)",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "nom",
      "geste",
      "vitesse",
      "rythme",
      "erreurAEviter",
      "difficulte",
      "videos",
      "sources",
      "dateVerif"
    ],
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "nom": {
        "type": "string",
        "minLength": 1
      },
      "geste": {
        "type": "string",
        "minLength": 1
      },
      "vitesse": {
        "type": "string",
        "minLength": 1
      },
      "rythme": {
        "enum": [
          "lent",
          "moyen",
          "rapide"
        ]
      },
      "erreurAEviter": {
        "type": "string",
        "minLength": 1
      },
      "difficulte": {
        "type": "integer",
        "minimum": 1,
        "maximum": 3
      },
      "videos": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "provider"
          ],
          "additionalProperties": false,
          "properties": {
            "provider": {
              "enum": [
                "youtube",
                "vimeo",
                "dailymotion",
                "self"
              ]
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "start": {
              "type": "integer",
              "minimum": 0
            },
            "auteur": {
              "type": "string",
              "minLength": 1
            },
            "lienAuteur": {
              "type": "string",
              "minLength": 1
            },
            "dateVerif": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "format": "date"
            },
            "fichier": {
              "type": "string",
              "minLength": 1
            },
            "boucle": {
              "type": "boolean"
            },
            "horsLigne": {
              "type": "boolean"
            },
            "licence": {
              "type": "string",
              "minLength": 1
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "provider": {
                    "const": "youtube"
                  }
                },
                "required": [
                  "provider"
                ]
              },
              "then": {
                "required": [
                  "id"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "provider": {
                    "const": "vimeo"
                  }
                },
                "required": [
                  "provider"
                ]
              },
              "then": {
                "required": [
                  "id"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "provider": {
                    "const": "dailymotion"
                  }
                },
                "required": [
                  "provider"
                ]
              },
              "then": {
                "required": [
                  "id"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "provider": {
                    "const": "self"
                  }
                },
                "required": [
                  "provider"
                ]
              },
              "then": {
                "required": [
                  "fichier"
                ]
              }
            }
          ]
        }
      },
      "saisons": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "enum": [
            "hiver",
            "printemps",
            "été",
            "automne"
          ]
        }
      },
      "sources": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "dateVerif": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "format": "date"
      }
    }
  }
}
