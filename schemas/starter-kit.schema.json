{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Kit de départ (starter-kit.json)",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "typeId",
      "raison",
      "sources",
      "dateVerif"
    ],
    "additionalProperties": false,
    "properties": {
      "typeId": {
        "type": "string",
        "minLength": 1
      },
      "raison": {
        "type": "string",
        "minLength": 1
      },
      "sources": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "dateVerif": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "format": "date"
      }
    }
  }
}
