{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Fiches espèces (species.json)",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "code",
      "nom",
      "tempEauC",
      "postes",
      "proies",
      "tailleMinCm",
      "fermetureAvecBrochet",
      "verifDepartementPrintemps",
      "sources",
      "dateVerif"
    ],
    "additionalProperties": false,
    "properties": {
      "code": {
        "type": "string",
        "minLength": 1
      },
      "nom": {
        "type": "string",
        "minLength": 1
      },
      "tempEauC": {
        "type": "object",
        "required": [
          "active",
          "ralentie",
          "quasiNulle"
        ],
        "additionalProperties": false,
        "properties": {
          "active": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number"
            }
          },
          "ralentie": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number"
            }
          },
          "quasiNulle": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number"
            }
          }
        }
      },
      "postes": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "proies": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "tailleMinCm": {
        "type": [
          "number",
          "null"
        ],
        "minimum": 0
      },
      "fermetureAvecBrochet": {
        "type": "boolean"
      },
      "fermetureSpecifique": {
        "type": [
          "string",
          "null"
        ]
      },
      "verifDepartementPrintemps": {
        "type": "boolean"
      },
      "sources": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "dateVerif": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "format": "date"
      }
    }
  }
}
