{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Fédérations de pêche (federations.json)",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "departement",
      "nom",
      "url",
      "sources",
      "dateVerif"
    ],
    "additionalProperties": false,
    "properties": {
      "departement": {
        "type": "string",
        "minLength": 1
      },
      "nom": {
        "type": "string",
        "minLength": 1
      },
      "url": {
        "type": "string",
        "pattern": "^https://"
      },
      "sources": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "dateVerif": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "format": "date"
      }
    }
  }
}
