{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Couleurs de leurre (couleurs.json)",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "nom",
      "classe",
      "sources",
      "dateVerif"
    ],
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "nom": {
        "type": "string",
        "minLength": 1
      },
      "classe": {
        "enum": [
          "vive",
          "naturelle"
        ],
        "description": "Vive pour l'eau trouble, naturelle pour l'eau claire. La première couleur du fichier est la couleur par défaut : elle doit être naturelle."
      },
      "sources": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "dateVerif": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "format": "date"
      }
    }
  }
}
