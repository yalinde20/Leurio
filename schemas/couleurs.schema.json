{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Couleurs de leurre (couleurs.json)",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "nom",
      "classe",
      "sources",
      "dateVerif"
    ],
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "nom": {
        "type": "string",
        "minLength": 1
      },
      "classe": {
        "enum": [
          "vive",
          "naturelle"
        ],
        "description": "Vive pour l'eau trouble, naturelle pour l'eau claire. La couleur par défaut est la première couleur naturelle du fichier. Le fichier doit contenir au moins une couleur vive et une naturelle."
      },
      "sources": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "dateVerif": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "format": "date"
      }
    }
  }
}
