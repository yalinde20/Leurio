{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Contours des départements de métropole et d'outre-mer (departements.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["sources", "dateVerif", "departements"],
  "properties": {
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "dateVerif": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "departements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "nom", "polygones"],
        "properties": {
          "code": { "type": "string", "pattern": "^(\\d{2}|2A|2B|97[1-46])$" },
          "nom": { "type": "string", "minLength": 1 },
          "polygones": {
            "type": "array",
            "minItems": 1,
            "description": "Un polygone par île ou morceau : l'anneau extérieur, puis les trous éventuels ; chaque anneau est fermé.",
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "minItems": 4,
                "description": "Anneau fermé de points [longitude, latitude].",
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": { "type": "number" }
                }
              }
            }
          }
        }
      }
    }
  }
}
