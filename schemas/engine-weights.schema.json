{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Poids du moteur (engine-weights.json)",
  "type": "object",
  "required": [
    "temperature",
    "saison",
    "clarte",
    "luminosite",
    "pression",
    "lune",
    "penaliteDifficulte",
    "seuilCielCouvert"
  ],
  "properties": {
    "temperature": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Poids de la température de l'eau (fort)."
    },
    "saison": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Poids de la saison (moyen)."
    },
    "clarte": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Poids de la clarté de l'eau (moyen)."
    },
    "luminosite": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Poids de la luminosité (faible)."
    },
    "pression": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Poids de la pression atmosphérique (faible)."
    },
    "lune": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Poids de la lune : bonus seulement, jamais négatif."
    },
    "seuilCielCouvert": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Pourcentage de nuages à partir duquel le ciel est couvert et la lumière faible."
    },
    "penaliteDifficulte": {
      "type": "number",
      "exclusiveMaximum": 0,
      "description": "Pénalité négative ajoutée au score quand la difficulté de l'animation dépasse le niveau du pêcheur."
    }
  },
  "additionalProperties": {
    "type": "number"
  }
}
