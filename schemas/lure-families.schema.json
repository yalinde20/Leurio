{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Familles de leurres (lure-families.json)",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "nom",
      "pictogramme",
      "sources",
      "dateVerif"
    ],
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "nom": {
        "type": "string",
        "minLength": 1,
        "description": "Libellé de la puce du filtre de la boîte."
      },
      "pictogramme": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9/_-]*\\.svg$",
        "description": "Chemin du pictogramme SVG, relatif à src/assets/ (ex. pictogrammes/souples.svg)."
      },
      "sources": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "dateVerif": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "format": "date"
      }
    }
  }
}
